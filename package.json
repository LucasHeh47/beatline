{
  "name": "beatline",
  "productName": "Beatline",
  "version": "0.1.0",
  "description": "Make beats, write songs and record your guitar: a step sequencer, piano roll, playlist, mixer with effects and guitar amps, a tuner, and exports to WAV and MP3.",
  "main": "dist-electron/main.js",
  "private": true,
  "author": "LucasHeh47",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LucasHeh47/beatline.git"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json && vite build && node scripts/build-electron.mjs",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "release": "npm run build && electron-builder --win --publish never && node scripts/publish-release.mjs"
  },
  "devDependencies": {
    "@mediabunny/mp3-encoder": "1.61.3",
    "@types/node": "^26.6.5",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "lucide": "^1.55.0",
    "mediabunny": "1.61.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "com.beatline.app",
    "productName": "Beatline",
    "copyright": "Beatline",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "LucasHeh47",
        "repo": "beatline",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Beatline",
      "artifactName": "Beatline-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Beatline-Portable-${version}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "beatline",
        "name": "Beatline project",
        "description": "Beatline music project",
        "role": "Editor",
        "icon": "build/icon.ico"
      }
    ],
    "electronLanguages": [
      "en-US"
    ]
  }
}
